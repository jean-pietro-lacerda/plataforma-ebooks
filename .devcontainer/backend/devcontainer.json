{
  "name": "Plataforma E-books - Backend",
  "dockerComposeFile": "../../compose.yaml",
  "service": "backend",
  "workspaceFolder": "/workspace",
  "runServices": ["backend"],
  "shutdownAction": "none",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}